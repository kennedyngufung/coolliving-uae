# CoolLivingUAE — environment configuration
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Amazon.ae Associates tracking ID, issued on programme approval.
# Example format: coollivinguae-21
# Leave blank until approved: links still work, they simply earn no commission.
VITE_AMAZON_AE_TAG=

# Noon affiliate campaign identifier, issued on programme approval.
VITE_NOON_TAG=
