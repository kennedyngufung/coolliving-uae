# CoolLivingUAE — environment configuration
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Amazon.ae Associates tracking ID, issued on programme approval.
# Example format: coollivinguae-21
# Leave blank until approved: links still work, they simply earn no commission.
VITE_AMAZON_AE_TAG=

# Noon affiliate campaign identifier, issued on programme approval.
VITE_NOON_TAG=

# Google Analytics 4 measurement ID, e.g. G-ABC1234XYZ.
# Create at analytics.google.com → Admin → Data Streams → Web.
# Leave blank to disable analytics entirely: no script loads, no cookies set.
VITE_GA4_ID=

# Public site origin, used for canonical URLs, Open Graph tags, and the sitemap.
# Defaults to https://coollivinguae.com. Override to point everything at a
# different address (a Vercel URL, a staging domain) without touching code.
VITE_SITE_URL=
